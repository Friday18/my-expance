# Local development. Copy to .env and fill in.
AUTH_MODE=dev                      # dev = any bearer token is treated as the user id. Use "firebase" in production.
FIREBASE_PROJECT_ID=
DATABASE_URL=sqlite:///myexpance.db

# --- Assistant model -------------------------------------------------
# Free: create a key at https://console.groq.com/keys (no card needed)
LLM_PROVIDER=groq
GROQ_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b      # optional; e.g. llama-3.3-70b-versatile

# Other options (set LLM_PROVIDER to one of these):
#   gemini    -> GEMINI_API_KEY from https://aistudio.google.com/apikey
#   ollama    -> free and offline: install Ollama, run `ollama pull qwen3:8b`
#   anthropic -> ANTHROPIC_API_KEY (paid), ANTHROPIC_MODEL=claude-haiku-5-5
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
CHAT_DAILY_LIMIT=60
SUPPORT_EMAIL=you@example.com
DEVELOPER_NAME=Your Name
SENTRY_DSN=
CORS_ORIGINS=*
